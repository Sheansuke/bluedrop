---
import { Image } from "astro:assets"
import bomba1 from "../assets/bomba1.jpg"
import industrial1 from "../assets/industrial1.jpg"
import industrial3 from "../assets/industrial3.jpg"
import vasoagua from "../assets/vasoaguav3.png"
import Footer from "../components/Footer/Footer.astro"
import Navbar from "../components/Navbar/Navbar.astro"
import Layout from "../layouts/Layout.astro"

const title = "Tratamiento de agua en Santo Domingo y RD | BlueDrop SRL"
const description =
  "Tratamiento de agua en Santo Domingo y República Dominicana. Más que una compañía, somos tus aliados: instalación, equipos y mantenimiento residencial e industrial."

const faqItems = [
  {
    question: "¿Qué es el tratamiento de agua?",
    answer:
      "El tratamiento de agua es el conjunto de procesos y equipos que mejoran la calidad del agua para consumo, procesos productivos o uso doméstico. En BlueDrop diseñamos e instalamos soluciones de filtración, purificación y acondicionamiento según las necesidades de cada espacio.",
  },
  {
    question: "¿BlueDrop ofrece tratamiento de agua en Santo Domingo?",
    answer:
      "Sí. Operamos desde Los Prados, Santo Domingo (Distrito Nacional), y atendemos hogares, comercios e industrias en Santo Domingo y el resto de República Dominicana. Contáctanos para una evaluación.",
  },
  {
    question: "¿Qué zonas cubren en República Dominicana?",
    answer:
      "Nuestra base está en Santo Domingo. Atendemos proyectos en el Distrito Nacional y zonas aledañas, y coordinamos instalaciones y mantenimiento en otras localidades del país según el alcance del sistema.",
  },
  {
    question: "¿Qué incluye la instalación de un sistema de tratamiento de agua?",
    answer:
      "Incluye evaluación de necesidades, propuesta de equipos de filtración o purificación, instalación profesional y orientación para el uso y mantenimiento. El alcance exacto se define en la cotización según el tipo de inmueble o planta.",
  },
  {
    question: "¿Cuánto tarda una evaluación o cotización?",
    answer:
      "Puedes solicitarla por teléfono, WhatsApp o correo. En la mayoría de los casos respondemos en el mismo día hábil para agendar visita o enviarte una primera orientación según el tipo de tratamiento de agua que necesitas.",
  },
  {
    question: "¿Hacen mantenimiento de sistemas de agua en Santo Domingo?",
    answer:
      "Sí. Ofrecemos mantenimiento preventivo y correctivo de sistemas de tratamiento de agua, equipos de bombeo y sistemas relacionados, para proteger tu inversión y la calidad del agua.",
  },
  {
    question: "¿El tratamiento de agua es lo mismo que el servicio de piscinas?",
    answer:
      "No. El tratamiento de agua se enfoca en la calidad del agua que usas en casa, comercio o industria. Los servicios de piscinas y jacuzzis son una línea complementaria: instalación, mantenimiento, minerales y suministros.",
  },
  {
    question: "¿Cómo solicito una evaluación de tratamiento de agua?",
    answer:
      "Llámanos al +1 (849) 584-7374, escríbenos por WhatsApp o al correo bluedropventas@gmail.com. Más que una compañía, somos tus aliados para encontrar la solución adecuada.",
  },
]

const extraJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: "https://www.bluedroprd.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Tratamiento de agua",
          item: "https://www.bluedroprd.com/tratamiento-de-agua/",
        },
      ],
    },
    {
      "@type": "Service",
      name: "Tratamiento de agua",
      serviceType: "Tratamiento de agua",
      provider: {
        "@type": "LocalBusiness",
        name: "BlueDrop SRL",
        telephone: "+1 (849) 584-7374",
        email: "bluedropventas@gmail.com",
        address: {
          "@type": "PostalAddress",
          streetAddress:
            "Av. Charles Summer #19B Plaza Lesmar local 203 segundo nivel",
          addressLocality: "Los Prados",
          addressRegion: "Santo Domingo",
          addressCountry: "DO",
        },
      },
      areaServed: [
        {
          "@type": "City",
          name: "Santo Domingo",
        },
        {
          "@type": "Country",
          name: "República Dominicana",
        },
      ],
      url: "https://www.bluedroprd.com/tratamiento-de-agua/",
      description,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
}
---

<Layout title={title} description={description} extraJsonLd={extraJsonLd}>
  <Navbar
    breadcrumbs={[
      { label: "Inicio", href: "/" },
      { label: "Tratamiento de agua" },
    ]}
  />

  <main>
    <section
      class="bg-gradient-to-b from-blue-100 via-blue-50 to-white px-6 py-16 md:px-12 md:py-24"
      aria-labelledby="tratamiento-heading"
    >
      <div class="container mx-auto grid items-center gap-12 md:grid-cols-2">
        <div>
          <p class="mb-4 text-lg font-medium uppercase tracking-wide text-brand md:text-xl">
            BlueDrop SRL · República Dominicana
          </p>
          <h1
            id="tratamiento-heading"
            class="mb-6 text-4xl font-black uppercase leading-tight text-[rgb(11,65,88)] md:text-5xl lg:text-6xl"
          >
            Tratamiento de agua en Santo Domingo
          </h1>
          <p class="mb-4 text-xl font-medium text-gray-800 md:text-3xl">
            Más que una compañía, somos tus aliados
          </p>
          <p class="mb-8 text-lg text-gray-700 md:text-xl">
            Somos aliados de un recurso tan transparente como lo es el agua.
            Instalamos, mantenemos y equipamos sistemas de tratamiento de agua
            para uso residencial, comercial e industrial en Santo Domingo y
            República Dominicana.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="tel:+18495847374"
              class="rounded-lg bg-brand px-6 py-3 text-lg font-semibold text-white hover:bg-brand-hover"
            >
              Llamar +1 (849) 584-7374
            </a>
            <a
              href="https://wa.me/18495847374"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border-2 border-brand px-6 py-3 text-lg font-semibold text-brand hover:bg-blue-50"
            >
              WhatsApp
            </a>
          </div>
        </div>
        <div class="flex justify-center">
          <Image
            src={vasoagua}
            alt="Vaso de agua limpia, resultado del tratamiento de agua de BlueDrop SRL en Santo Domingo"
            width={420}
            height={1080}
            loading="eager"
            fetchpriority="high"
            class="max-w-full h-auto"
          />
        </div>
      </div>
    </section>

    <section
      class="container mx-auto px-6 py-16 md:px-12"
      aria-labelledby="cobertura-heading"
    >
      <h2
        id="cobertura-heading"
        class="mb-4 text-3xl font-bold text-[rgb(11,65,88)] md:text-5xl"
      >
        Tratamiento de agua en Santo Domingo y RD
      </h2>
      <p class="mb-6 max-w-4xl text-lg text-gray-700 md:text-xl">
        BlueDrop SRL es una empresa de tratamiento de agua con base en Los
        Prados, Santo Domingo. Acompañamos hogares, comercios e industrias en
        República Dominicana desde la evaluación hasta el mantenimiento.
      </p>
      <div class="grid gap-8 md:grid-cols-3">
        <article class="rounded-lg border border-gray-200 bg-white p-6">
          <h3 class="mb-2 text-xl font-semibold text-[rgb(11,65,88)] md:text-2xl">
            1. Evaluación
          </h3>
          <p class="text-base text-gray-700 md:text-lg">
            Revisamos tu necesidad de filtración, purificación o acondicionamiento
            de agua y te orientamos sobre el sistema adecuado.
          </p>
        </article>
        <article class="rounded-lg border border-gray-200 bg-white p-6">
          <h3 class="mb-2 text-xl font-semibold text-[rgb(11,65,88)] md:text-2xl">
            2. Instalación
          </h3>
          <p class="text-base text-gray-700 md:text-lg">
            Instalamos sistemas de tratamiento de agua y equipos relacionados
            con personal técnico en Santo Domingo y según cobertura nacional.
          </p>
        </article>
        <article class="rounded-lg border border-gray-200 bg-white p-6">
          <h3 class="mb-2 text-xl font-semibold text-[rgb(11,65,88)] md:text-2xl">
            3. Mantenimiento
          </h3>
          <p class="text-base text-gray-700 md:text-lg">
            Mantenimiento preventivo y correctivo para que tu sistema de agua
            siga rindiendo con seguridad y continuidad.
          </p>
        </article>
      </div>
      <p class="mt-8 text-base text-gray-700 md:text-lg">
        Oficina:
        <strong>
          Av. Charles Summer #19B Plaza Lesmar local 203, Los Prados, Santo
          Domingo
        </strong>
        · Tel.
        <a href="tel:+18495847374" class="font-semibold text-brand hover:underline">
          +1 (849) 584-7374
        </a>
      </p>
      <p class="mt-4 text-base text-gray-700 md:text-lg">
        También puedes ver nuestra página de
        <a
          href="/tratamiento-de-agua-santo-domingo"
          class="font-semibold text-brand hover:underline"
        >
          tratamiento de agua en Santo Domingo
        </a>
        o
        <a
          href="/tratamiento-de-agua-residencial-industrial"
          class="font-semibold text-brand hover:underline"
        >
          soluciones residenciales e industriales
        </a>.
      </p>
    </section>

    <section class="container mx-auto px-6 py-16 md:px-12" aria-labelledby="servicios-tratamiento">
      <h2
        id="servicios-tratamiento"
        class="mb-4 text-3xl font-bold text-[rgb(11,65,88)] md:text-5xl"
      >
        Soluciones de tratamiento de agua
      </h2>
      <p class="mb-12 max-w-4xl text-lg text-gray-700 md:text-xl">
        En BlueDrop el tratamiento de agua no es un producto aislado: es un
        acompañamiento completo, desde el diagnóstico hasta el mantenimiento.
      </p>

      <div class="grid gap-10 md:grid-cols-2">
        <article>
          <h3 class="mb-3 text-2xl font-semibold text-[rgb(11,65,88)] md:text-3xl">
            Instalación de tratamiento de agua
          </h3>
          <p class="text-lg text-gray-700">
            Diseñamos e instalamos sistemas de tratamiento de agua a la medida
            de tu hogar, comercio o planta en Santo Domingo. Equipos de
            filtración, purificación y distribución con instalación profesional.
          </p>
        </article>
        <article>
          <h3 class="mb-3 text-2xl font-semibold text-[rgb(11,65,88)] md:text-3xl">
            Equipos de tratamiento de agua
          </h3>
          <p class="text-lg text-gray-700">
            Venta de equipos de tratamiento de agua, bombas, accesorios y
            recambios en República Dominicana para mantener tu sistema
            funcionando con agua más segura.
          </p>
        </article>
        <article>
          <h3 class="mb-3 text-2xl font-semibold text-[rgb(11,65,88)] md:text-3xl">
            Mantenimiento de sistemas de agua
          </h3>
          <p class="text-lg text-gray-700">
            Mantenimiento preventivo y correctivo de sistemas de tratamiento de
            agua en Santo Domingo para proteger tu inversión y la calidad del
            agua que usas cada día.
          </p>
        </article>
        <article>
          <h3 class="mb-3 text-2xl font-semibold text-[rgb(11,65,88)] md:text-3xl">
            Purificación y suministros
          </h3>
          <p class="text-lg text-gray-700">
            Soluciones de purificación de agua y suministros complementarios
            para sistemas de agua y piscinas, con el respaldo de un equipo local.
          </p>
        </article>
      </div>
    </section>

    <section class="bg-[#231f20] px-6 py-16 text-white md:px-12" aria-labelledby="residencial-industrial">
      <div class="container mx-auto grid items-center gap-10 md:grid-cols-2">
        <div>
          <h2 id="residencial-industrial" class="mb-4 text-3xl font-bold md:text-5xl">
            Residencial e industrial
          </h2>
          <p class="mb-4 text-lg text-gray-200 md:text-xl">
            <strong class="text-white">Residencial:</strong>
            tratamiento de agua para viviendas y comercios en Santo Domingo —
            filtración, purificación y equipos pensados para el día a día del
            hogar o el negocio.
          </p>
          <p class="mb-6 text-lg text-gray-200 md:text-xl">
            <strong class="text-white">Industrial:</strong>
            sistemas de tratamiento de agua para plantas e instalaciones
            productivas en República Dominicana, con instalación y seguimiento
            técnico.
          </p>
          <a
            href="/tratamiento-de-agua-residencial-industrial"
            class="text-lg font-semibold text-brand-on-dark hover:underline"
          >
            Ver tratamiento de agua residencial e industrial
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <Image
            src={bomba1}
            alt="Equipos de bombeo para tratamiento de agua residencial e industrial en Santo Domingo - BlueDrop SRL"
            width={500}
            height={500}
            widths={[305, 500]}
            sizes="(max-width: 768px) 50vw, 250px"
            class="h-auto w-full rounded-lg object-cover"
          />
          <Image
            src={industrial1}
            alt="Instalación industrial de tratamiento de agua en República Dominicana - BlueDrop SRL"
            width={500}
            height={500}
            widths={[305, 500]}
            sizes="(max-width: 768px) 50vw, 250px"
            class="h-auto w-full rounded-lg object-cover"
          />
        </div>
      </div>
    </section>

    <section class="container mx-auto px-6 py-16 md:px-12" aria-labelledby="faq-heading">
      <div class="grid items-start gap-10 md:grid-cols-2">
        <div>
          <h2 id="faq-heading" class="mb-8 text-3xl font-bold text-[rgb(11,65,88)] md:text-5xl">
            Preguntas frecuentes sobre tratamiento de agua
          </h2>
          <div class="space-y-4">
            {
              faqItems.map((item) => (
                <details class="rounded-lg border border-gray-200 bg-white p-4">
                  <summary class="cursor-pointer text-lg font-semibold text-[rgb(11,65,88)] md:text-xl">
                    {item.question}
                  </summary>
                  <p class="mt-3 text-base text-gray-700 md:text-lg">{item.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
        <Image
          src={industrial3}
          alt="Proyecto de tratamiento de agua residencial e industrial de BlueDrop SRL en República Dominicana"
          width={800}
          height={500}
          class="h-auto w-full rounded-xl object-cover"
        />
      </div>
    </section>

    <section class="bg-blue-50 px-6 py-16 text-center md:px-12" aria-labelledby="cta-heading">
      <h2 id="cta-heading" class="mb-4 text-3xl font-bold text-[rgb(11,65,88)] md:text-5xl">
        Hablemos de tu tratamiento de agua
      </h2>
      <p class="mx-auto mb-8 max-w-3xl text-lg text-gray-700 md:text-xl">
        Más que una compañía, somos tus aliados. Comunícate con BlueDrop SRL
        para evaluar tu sistema de tratamiento de agua en Santo Domingo y
        República Dominicana.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="tel:+18495847374"
          class="rounded-lg bg-brand px-6 py-3 text-lg font-semibold text-white hover:bg-brand-hover"
        >
          +1 (849) 584-7374
        </a>
        <a
          href="https://wa.me/18495847374"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-[#231f20] px-6 py-3 text-lg font-semibold text-white hover:bg-black"
        >
          WhatsApp
        </a>
        <a
          href="mailto:bluedropventas@gmail.com"
          class="rounded-lg border-2 border-[#231f20] px-6 py-3 text-lg font-semibold text-[#231f20] hover:bg-white"
        >
          bluedropventas@gmail.com
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
