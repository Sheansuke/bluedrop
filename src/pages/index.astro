---
import { Image } from "astro:assets"
import pretratamientoOriginal from "../assets/v2/pretratamiento-original.png"
import purificadorSinMarca from "../assets/v2/purificador-sin-marca.png"
import pagina8 from "../assets/pagina8.jpg"
import pagina10 from "../assets/pagina10-sin-marcas.png"
import vasoagua from "../assets/vasoaguav3.png"
import EquiposAccesoriosSection from "../components/EquiposAccesorios/EquiposAccesoriosSection.astro"
import Footer from "../components/Footer/Footer.astro"
import Hero from "../components/Hero/Hero.astro"
import InstalacionSection from "../components/Instalacion/InstalacionSection.astro"
import MantenimientoSection from "../components/Mantenimiento/MantenimientoSection.astro"
import Menu from "../components/Menu/Menu.astro"
import MineralesSuministrosSection from "../components/MineralesSuministros/MineralesSuministrosSection.astro"
import MobileVideoHd from "../components/MobileVideo/MobileVideoHd.astro"
import Navbar from "../components/Navbar/Navbar.astro"
import RemodelacionSection from "../components/Remodelacion/RemodelacionSection.astro"
import ResidencialIndustiaSection from "../components/Residencial-Industria/ResidencialIndustiaSection.astro"
import Layout from "../layouts/Layout.astro"
---

<Layout
  title="BlueDrop SRL | Aliados del agua en República Dominicana"
  description="Más que una compañía, somos tus aliados. BlueDrop SRL ofrece tratamiento de agua, equipos y mantenimiento para hogares e industrias en Santo Domingo, RD."
>
  <Navbar />
  
  <main>
    <Hero />

    <Menu />

    <section class="container mx-auto flex justify-center" aria-label="Filosofía de BlueDrop">
      <div
        class="flex flex-col md:flex-row items-center md:items-start justify-between w-full mb-36"
      >
        <div class="md:w-1/2 text-left flex flex-col justify-center md:pr-8">
          <h2
            class="text-4xl md:text-6xl font-bold mb-4 mt-8 text-[rgb(11,65,88)]"
          >
            Sé como el agua
          </h2>
          <p class="text-lg md:text-xl text-gray-700 mb-4">
            Somos aliados de un recurso tan transparente como lo es el agua.
          </p>
          <p class="text-lg md:text-xl text-gray-700 mb-4">
            No es lujosa, pero sí muy valiosa.
          </p>
          <p class="text-lg md:text-xl text-gray-700">
            Más que una compañía, somos tus aliados en el
            <a
              href="/tratamiento-de-agua"
              class="font-semibold text-brand hover:underline"
            >
              tratamiento de agua
            </a>
            para hogares e industrias en República Dominicana. También ofrecemos
            <a
              href="/tratamiento-de-agua-santo-domingo"
              class="font-semibold text-brand hover:underline"
            >
              tratamiento de agua en Santo Domingo
            </a>
            y soluciones
            <a
              href="/tratamiento-de-agua-residencial-industrial"
              class="font-semibold text-brand hover:underline"
            >
              residenciales e industriales
            </a>.
          </p>
        </div>
        <div class="md:w-1/2 flex justify-center mt-8 md:mt-0">
          <Image
            width={400}
            height={1080}
            src={vasoagua}
            alt="Vaso de agua limpia, símbolo del tratamiento de agua de BlueDrop SRL en República Dominicana"
            loading="lazy"
            class="max-w-full h-auto"
          />
        </div>
      </div>
    </section>

    <MobileVideoHd />

    <InstalacionSection />

    <EquiposAccesoriosSection />

    <RemodelacionSection />

    <MantenimientoSection />

    <section aria-labelledby="servicios-adicionales-heading">
      <div class="container mx-auto px-6 py-8 md:px-12">
        <h2 id="servicios-adicionales-heading" class="text-2xl md:text-4xl font-bold text-[rgb(11,65,88)]">
          Servicios profesionales
        </h2>
        <p class="mt-2 text-lg text-gray-700">
          Ofrecemos servicios de tratamiento de agua, piscinas y jacuzzis,
          construcción, remodelación de espacios y electricidad en República Dominicana.
        </p>
      </div>
      <div id="pagina7" class="container mx-auto px-6 pb-12 md:px-12 md:pb-16 scroll-mt-20">
        <div class="grid gap-6 md:grid-cols-2 md:gap-8">
          <article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-md">
            <div class="flex h-64 items-center justify-center bg-slate-50 p-6 md:h-80">
              <Image src={pretratamientoOriginal} alt="Sistema de pretratamiento con tres tanques de filtración" width={689} height={574} class="h-full w-full object-contain" loading="lazy" />
            </div>
            <div class="p-6 md:p-8">
              <h3 class="text-xl font-bold text-[rgb(11,65,88)] md:text-2xl">Sistema de pretratamiento</h3>
              <p class="mt-3 leading-relaxed text-gray-700">Ayuda a reducir sedimentos y otras impurezas antes de las siguientes etapas de tratamiento. Su configuración depende de la calidad del agua y de las necesidades de cada instalación.</p>
            </div>
          </article>
          <article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-md">
            <div class="flex h-64 items-center justify-center bg-slate-50 p-6 md:h-80">
              <Image src={purificadorSinMarca} alt="Sistema de purificación por ósmosis inversa con tanque y grifo" width={900} height={600} class="h-full w-full object-contain" loading="lazy" />
            </div>
            <div class="p-6 md:p-8">
              <h3 class="text-xl font-bold text-[rgb(11,65,88)] md:text-2xl">Sistema de purificación</h3>
              <p class="mt-3 leading-relaxed text-gray-700">La ósmosis inversa ayuda a reducir sustancias disueltas en el agua. Según el sistema y la aplicación, puede complementarse con desinfección ultravioleta.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section aria-labelledby="soluciones-integrales-heading">
      <div class="container mx-auto px-6 py-8 md:px-12">
        <h2 id="soluciones-integrales-heading" class="text-2xl md:text-4xl font-bold text-[rgb(11,65,88)]">
          Soluciones integrales de tratamiento de agua
        </h2>
        <p class="mt-2 text-lg text-gray-700">
          Somos aliados de un recurso tan transparente como lo es el agua:
          diagnóstico, instalación, equipos y seguimiento.
        </p>
      </div>
      <Image
        id="pagina8"
        src={pagina8}
        alt="Soluciones integrales de tratamiento de agua y sistemas de piscinas - BlueDrop SRL"
        width={1920}
        height={1080}
        class="w-screen object-fill"
      />
    </section>

    <MineralesSuministrosSection />

    <section aria-labelledby="piscinas-heading">
      <div class="container mx-auto px-6 py-8 md:px-12">
        <h2 id="piscinas-heading" class="text-2xl md:text-4xl font-bold text-[rgb(11,65,88)]">
          Servicios de piscinas y jacuzzis
        </h2>
        <p class="mt-2 text-lg text-gray-700">
          Complementamos el tratamiento de agua con instalación y mantenimiento
          de piscinas y jacuzzis.
        </p>
      </div>
      <Image
        id="logo10"
        src={pagina10}
        alt="Servicios especializados de piscinas y jacuzzis - BlueDrop SRL"
        width={1920}
        height={1250}
        class="w-screen object-fill"
      />
    </section>

    <ResidencialIndustiaSection />
  </main>
  
  <Footer />
</Layout>
