---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  extraJsonLd?: Record<string, unknown>;
}

const {
  title = "BlueDrop SRL | Aliados del agua en República Dominicana",
  description = "Más que una compañía, somos tus aliados. BlueDrop SRL ofrece tratamiento de agua, equipos y mantenimiento para hogares e industrias en Santo Domingo, RD.",
  image = "/og-tratamiento-de-agua.jpg",
  type = "website",
  extraJsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const businessUrl = new URL("/", siteOrigin).href;
const fullImageUrl = image.startsWith("http")
  ? image
  : new URL(image, siteOrigin).href;

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "BlueDrop SRL",
  image: fullImageUrl,
  "@id": businessUrl,
  url: businessUrl,
  telephone: "+1 (849) 584-7374",
  email: "bluedropventas@gmail.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Charles Summer #19B Plaza Lesmar local 203 segundo nivel",
    addressLocality: "Los Prados",
    addressRegion: "Santo Domingo",
    addressCountry: "DO",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "18.4861",
    longitude: "-69.9312",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
    ],
    opens: "08:00",
    closes: "18:00",
  },
  priceRange: "$$",
  description,
  sameAs: ["https://www.instagram.com/bluedroprd/"],
  areaServed: {
    "@type": "Country",
    name: "República Dominicana",
  },
  knowsAbout: [
    "tratamiento de agua",
    "purificación de agua",
    "sistemas de agua",
    "equipos de tratamiento de agua",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Tratamiento de agua y servicios relacionados",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Tratamiento de agua",
          description:
            "Sistemas de tratamiento de agua residencial, comercial e industrial en República Dominicana",
          url: new URL("/tratamiento-de-agua", siteOrigin).href,
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Instalación de Sistemas de Agua",
          description:
            "Instalación profesional de sistemas de tratamiento de agua y piscinas",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Venta de Accesorios y Equipos",
          description:
            "Venta de accesorios y equipos para tratamiento de agua y piscinas",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Remodelación de Espacios",
          description:
            "Remodelación profesional de espacios relacionados con agua y piscinas",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Mantenimiento en General",
          description:
            "Servicios de mantenimiento para tratamiento de agua, piscinas y sistemas de agua",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Minerales y Suministros",
          description: "Venta de minerales y suministros para piscinas",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Servicios de Piscinas y Jacuzzis",
          description: "Servicios especializados para piscinas y jacuzzis",
        },
      },
    ],
  },
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="BlueDrop SRL" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="language" content="Spanish" />
    <meta name="geo.region" content="DO" />
    <meta name="geo.placename" content="Santo Domingo, República Dominicana" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:site_name" content="BlueDrop SRL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:creator" content="@bluedroprd" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessJsonLd)}
    />

    {
      extraJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(extraJsonLd)}
        />
      )
    }

    <meta name="theme-color" content="#008cc7" />
    <meta name="msapplication-TileColor" content="#008cc7" />
  </head>
  <body class="scroll-smooth">
    <slot />

    <script>
      document.addEventListener("click", (e: any) => {
        const a = e.target.closest('a[href^="#"]') as any;
        if (!a) return;

        const id = decodeURIComponent(a.getAttribute("href").slice(1));
        const el = document.getElementById(id);
        if (!el) return;

        e.preventDefault();
        el.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    </script>
  </body>
</html>

<style>
  *,
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    scroll-behavior: smooth !important;
    overflow-x: hidden;
  }

  body {
    min-width: 100vw;
    max-width: 100vw;
  }
</style>
