---
// Footer component with contact information and social media links
---

<footer id="contact" class="bg-gray-50 py-16">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-7xl font-bold text-gray-900 mb-4">Contactanos</h2>
      <p class="text-4xl text-gray-600">
        Contacta con BlueDrop para todas tus soluciones de agua
      </p>
    </div>
    <div class="max-w-9xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12">
        <div class="bg-white p-16 rounded-xl shadow-lg">
          <h3 class="text-4xl font-semibold text-gray-900 mb-8">
            Información de Contacto
          </h3>
          <div class="space-y-8">
            <div class="flex items-center">
              <svg
                class="w-12 h-12 text-blue-600 mr-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              <span class="text-gray-700 text-4xl">+1 (849) 584-7374</span>
            </div>
            <div class="flex items-center">
              <svg
                class="w-12 h-12 text-blue-600 mr-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <span class="text-gray-700 text-4xl">bluedropventas@gmail.com</span>
            </div>
            <div class="flex items-center">
              <svg
                class="w-12 h-12 text-blue-600 mr-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="text-gray-700 text-4xl"
                >Av. Charles Summer #19B Plaza Lesmar local 203 segundo nivel, sector los Prados</span
              >
            </div>
          </div>
        </div>
        <!-- Social media section -->
        <div class="bg-white p-16 rounded-xl shadow-lg">
          <h3 class="text-4xl font-semibold text-gray-900 mb-8">
            Contactanos a nuestras redes sociales
          </h3>
          <div class="space-y-8">
            <div class="flex items-center">
              <svg
                class="w-12 h-12 text-blue-600 mr-6"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
              <a href="https://www.instagram.com/bluedroprd/" target="_blank" class="text-gray-700 text-4xl hover:text-blue-600 transition-colors">
                @bluedroprd
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
