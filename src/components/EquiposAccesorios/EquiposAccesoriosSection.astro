---

<section
  id="pagina4"
  class="w-full relative shadow-[0_20px_50px_rgba(0,140,199,0.2)] scroll-mt-20"
  aria-labelledby="equipos-heading"
>
  <div class="bg-[#231f20] flex flex-col justify-center items-center px-6 py-10">
    <h2
      id="equipos-heading"
      class="text-3xl md:text-5xl font-bold text-white text-center tracking-wider uppercase"
    >
      Venta de Accesorios / Equipo
    </h2>
    <p class="mt-3 max-w-3xl text-center text-base md:text-xl text-gray-200">
      Venta de equipos, bombas, válvulas automáticas y repuestos para tratamiento de agua, purificación y sistemas de piscinas.
    </p>
  </div>

  <div class="container mx-auto px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
      {items.map((item) => (
        <article class="bg-white rounded-xl p-4 flex flex-col items-center justify-between border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 group">
          <div class="w-full h-40 flex items-center justify-center p-2 mb-3 bg-gray-50/50 rounded-lg group-hover:bg-sky-50/40 transition-colors">
            <Image
              src={item.image}
              alt={item.alt}
              width={260}
              height={260}
              class="max-h-36 max-w-full w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="w-full text-center mt-auto">
            <span class="block text-[11px] font-semibold uppercase tracking-wider text-brand mb-1">
              {item.category}
            </span>
            <h3 class="text-sm md:text-base font-semibold text-gray-800 line-clamp-2">
              {item.title}
            </h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
