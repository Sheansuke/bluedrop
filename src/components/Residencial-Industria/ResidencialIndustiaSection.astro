---

import bomba1 from "../../assets/bomba1.jpg";
import bomba2 from "../../assets/bomba2.jpg";
import industrial1 from "../../assets/industrial1.jpg";
import industrial2 from "../../assets/industrial2.jpg";
import industrial3 from "../../assets/industrial3.jpg";
import industrial4 from "../../assets/industrial4.jpg";
import { Image } from "astro:assets";
---

<section class="w-full shadow-[0_20px_50px_rgba(0,140,199,0.4)] relative" aria-label="Servicios residenciales e industriales">
  <div class="bg-[#231f20] h-38 flex justify-center items-center">
    <h2 class="text-6xl text-white text-center">Residencial e Industrial</h2>
  </div>

  <!-- CONTENT -->
  <section class="py-8 flex flex-col items-center flex-wrap gap-8 justify-around" aria-label="Servicios residenciales e industriales">
    <!-- TEXT -->
    <div class="flex flex-wrap justify-center gap-8 md:gap-x-32 items-center ">
      <Image src={bomba1} alt="Sistemas de bombeo para servicios residenciales e industriales de agua - BlueDrop SRL" width={500} height={500} class="md:h-1/2 " />
      <Image src={bomba2} alt="Equipos de bombeo profesional para instalaciones residenciales e industriales - BlueDrop SRL" width={300} height={500} class="md:h-1/2" />
    
      <div class="flex flex-wrap ">
        <Image src={industrial1} alt="Instalaciones industriales de sistemas de agua y tratamiento - BlueDrop SRL" width={300} height={500} class="w-full md:w-auto md:h-1/2 p-4" />
        <Image src={industrial2} alt="Soluciones industriales para tratamiento y distribución de agua - BlueDrop SRL" width={300} height={500} class="w-full md:w-auto md:h-1/2 p-4" />
      </div>
   
    </div>


    <!-- VIDEO -->
    <div class="flex flex-col gap-4">
      <Image src={industrial3} alt="Proyectos residenciales e industriales de sistemas de agua completos - BlueDrop SRL" width={800} height={500} class="w-full md:w-7xl h-2/3 md:h-1/2 p-4" />
      <Image src={industrial4} alt="Instalaciones profesionales de agua para uso residencial e industrial - BlueDrop SRL" width={800} height={500} class="w-full  h-2/3 md:h-1/2 p-4" />
    </div>
  </section>
</section>
