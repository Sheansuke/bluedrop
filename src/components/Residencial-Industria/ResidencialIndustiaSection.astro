---
import heroVideo from "../../assets/residencial-industria-video.mp4";
---

<div class="w-full shadow-[0_20px_50px_rgba(0,140,199,0.4)] relative">
  <div class="bg-[#231f20] h-38 flex justify-center items-center">
    <h1 class="text-6xl text-white text-center">Residencial e Industrial</h1>
  </div>

  <!-- CONTENT -->
  <div class="py-8 flex gap-8 justify-around">
    <!-- TEXT -->
    <div>
        <h2 class="text-4xl font-bold">Titulo de Ejemplo</h2>
        <p class="text-lg">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.
        </p>
    </div>


    <!-- VIDEO -->
    <div>
        <video id="hero-video" controls loop playsinline preload="metadata" class="w-full h-full object-cover rounded-lg">
            <source src={heroVideo} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
    </div>
  </div>
</div>
