<section class="relative h-screen overflow-hidden">
  {/* Left Content */}
  <div class="relative z-10 flex items-center px-8 bg-gradient-to-b from-blue-100 via-blue-200 to-blue-300 md:bg-none md:px-16 lg:px-24">
    <div class="w-full md:w-1/2 h-screen flex flex-col justify-center">
      <h1
        class="text-center mb-8 font-sans text-6xl font-black uppercase leading-tight tracking-tight text-black md:text-6xl lg:text-9xl"
      >
        Somos
        <br class="hidden md:block" />
        Bluedrop
      </h1>

      <p
        class="text-center mb-14 font-sans text-2xl font-medium uppercase leading-relaxed tracking-wide text-gray-700 md:text-6xl"
      >
        Agua limpia, vida segura.
        <br />
        Soluciones sostenibles
        <br />
        para hoy y el futuro.
      </p>

      <p
        class="text-center font-sans  text-2xl font-medium uppercase leading-relaxed tracking-wide text-gray-700 md:text-6xl"
      >
        Si cuidamos el agua que utilizamos
        <br />
        cuidamos nuestra salud
      </p>
    </div>
  </div>

  {/* Geometric Shapes */}
  <div class="absolute inset-0 -z-0">
    {/* Light gray diagonal shape */}
    <div
      class="hidden md:block absolute z-40 right-0 top-0 h-full w-1/2 bg-gray-200"
      style={{
        clipPath: "polygon(27% 0, 100% 0, 100% 100%, 32% 100%, 0 50%)",
      }}
    >
    </div>

    {/* Black triangle */}
    <div
      class="hidden md:block absolute bottom-0 left-1/3 h-1/2 w-1/2 bg-black"
      style={{
        clipPath: "polygon(50% 0%, 20% 100%, 90% 100%)",
      }}
    >
    </div>

    {/* Blue accent */}
    <div
      class=" hidden md:block absolute bottom-0 right-0 h-32 w-1/4 bg-[#008cc7] z-50"
      style={{
        clipPath: "polygon(20% 0, 0 100%, 2000% 100%)",
      }}
    >
    </div>
  </div>
</section>
