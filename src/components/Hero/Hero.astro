---
import PromoVideo from "../PromoVideo/PromoVideo.astro"
---

<style>
  .video-clip-path {
    clip-path: polygon(27% 0, 100% 0, 100% 100%, 32% 100%, 0 50%);
  }
</style>

<section class="relative z-10 h-screen w-full overflow-hidden" aria-label="Hero section - BlueDrop SRL">
  <div
    class="relative z-10 flex w-full items-center bg-gradient-to-b from-blue-100 via-blue-200 to-blue-300 px-8 md:bg-none"
  >
    <div class="flex h-screen w-full flex-col justify-center md:w-1/2">
      <h1
        class="mb-8 text-center font-sans text-2xl font-black leading-tight tracking-tight text-black uppercase md:text-4xl lg:text-6xl 2xl:text-7xl"
      >
        BlueDrop
        <br />
        Tratamiento de agua
      </h1>

      <p
        class="mb-8 text-center font-sans text-xl font-medium leading-relaxed tracking-wide text-gray-700 uppercase md:text-2xl lg:text-3xl 2xl:text-4xl"
      >
        Más que una compañía,
        <br />
        somos tus aliados
      </p>

      <p
        class="text-center font-sans text-xl font-medium leading-relaxed tracking-wide text-gray-700 uppercase md:text-2xl md:text-blue-400 2xl:text-4xl"
      >
        Agua limpia, vida segura.
        <br />
        Soluciones sostenibles
        <br />
        para hoy y el futuro.
      </p>
    </div>
  </div>

  <div class="hidden md:block absolute top-0 right-0 z-40 h-full w-1/2 bg-gray-200 video-clip-path">
    <PromoVideo variant="hero" />
  </div>
</section>
