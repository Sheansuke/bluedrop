---
import heroVideo from "../../assets/hero-videov2.mp4";
---

<style>
  .video-clip-path {
    clip-path: polygon(27% 0, 100% 0, 100% 100%, 32% 100%, 0 50%);
  }
  
  .triangle-clip-path {
    clip-path: polygon(50% 0%, 20% 100%, 90% 100%);
  }
  
  .accent-clip-path {
    clip-path: polygon(20% 0, 0 100%, 2000% 100%);
  }
</style>

<section class="relative w-full h-screen overflow-hidden z-10" aria-label="Hero section - BlueDrop SRL">
  {/* Left Content */}
  <div
    class="relative z-10 w-full flex items-center px-8 bg-gradient-to-b from-blue-100 via-blue-200 to-blue-300 md:bg-none "
  >
    <div class="w-full md:w-1/2 h-screen flex flex-col justify-center">
      <h1
        class="text-2xl md:text-4xl lg:text-6xl 2xl:text-7xl text-center mb-8 font-sans font-black uppercase leading-tight tracking-tight text-black"
      >
        BlueDrop
        <br />
        Tratamiento de agua
      </h1>

      <p
        class="text-xl md:text-2xl lg:text-3xl 2xl:text-4xl text-center mb-8 font-sans font-medium uppercase leading-relaxed tracking-wide text-gray-700"
      >
        Más que una compañía,
        <br />
        somos tus aliados
      </p>

      <p
        class="text-xl md:text-2xl md:text-blue-400 2xl:text-4xl text-center font-sans font-medium uppercase leading-relaxed tracking-wide text-gray-700"
      >
        Agua limpia, vida segura.
        <br />
        Soluciones sostenibles
        <br />
        para hoy y el futuro.
      </p>
    </div>
  </div>

  {/* Geometric Shapes */}
  <div class="">
     {/* Light gray diagonal shape - Desktop only */}
     <div
       class="hidden md:block absolute z-40 right-0 top-0 h-full w-1/2 bg-gray-200 video-clip-path"
     >
      <video
        id="hero-video"
        class="w-full h-full mx-auto cursor-pointer object-cover"
        loop
        playsinline
        preload="metadata"
        muted
        aria-label="Video promocional de tratamiento de agua y servicios de BlueDrop SRL"
      >
       
        <source src={heroVideo} type="video/mp4" />
        Tu navegador no soporta el tag de video.
      </video>
      
      {/* Play/Pause Button */}
      <button
        id="play-pause-btn"
        class=" absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-black bg-opacity-50 hover:bg-opacity-70 text-white p-4 rounded-full transition-all duration-300 z-50"
        aria-label="Play/Pause video"
      >
        <svg
          id="play-icon"
          class="w-8 h-8 "
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>

   

  </div>
</section>

<script>
   document.addEventListener("DOMContentLoaded", function () {
     const video = document.getElementById("hero-video") as HTMLVideoElement;
     const playPauseBtn = document.getElementById("play-pause-btn");
     const playIcon = document.getElementById("play-icon");
 

     if (video) {
       // Function to toggle play/pause
       function togglePlayPause() {
         if (video.paused) {
           video.play();
           if (playIcon) playIcon.classList.add("hidden");
           if (playPauseBtn) playPauseBtn.classList.add("hidden");
          
         } else {
           video.pause();
           if (playIcon) playIcon.classList.remove("hidden");
            if (playPauseBtn) playPauseBtn.classList.remove("hidden");

         }
       }

       // Click anywhere on video to play/pause
       video.addEventListener("click", function (e) {
         e.preventDefault();
         e.stopPropagation();
         togglePlayPause();
       });

       // Play/Pause button functionality
       if (playPauseBtn) {
         playPauseBtn.addEventListener("click", function (e) {
           e.preventDefault();
           e.stopPropagation();
           togglePlayPause();
         });
       }

       // Update button states when video events occur
       video.addEventListener("play", function () {
         if (playIcon) playIcon.classList.add("hidden");
  
       });

       video.addEventListener("pause", function () {
         if (playIcon) playIcon.classList.remove("hidden");
     
       });

       // Initialize video with audio enabled (unmuted)
       video.muted = false;
     }
   });
</script>
