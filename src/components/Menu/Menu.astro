---
import MenuItem from "./MenuItem.astro";
import {
  PencilRuler,
  PackageOpen,
  Hammer,
  Wrench,
  Boxes,
  WavesLadder,
} from "@lucide/astro";
---

<div class="w-full pb-8 ">
  <div class="bg-[#231f20] h-38 flex justify-center items-center">
    <h1 class="text-6xl text-white text-center">SOLUCIONES QUE BRINDAMOS</h1>
  </div>

  <div class="container mx-auto " >
  <div class="flex flex-wrap justify-center md:grid md:grid-cols-3 gap-8 md:gap-24 mt-8 ">

      <MenuItem color="bg-black" title="INSTALACION" navigateTo="#logo3">
      <PencilRuler class="text-white size-30 md:size-60" slot="icon" />
    </MenuItem>

    <MenuItem color="bg-[#008cc7]" title="VENTA DE ACCESORIOS / EQUIPO" navigateTo="#logo4">
      <PackageOpen class="text-white size-30 md:size-60" slot="icon" />
    </MenuItem>

    <MenuItem color="bg-black" title="REMODELADO DE ESPACIOS" navigateTo="#logo5">
      <Hammer class="text-white size-30 md:size-60" slot="icon"/>
    </MenuItem>

    <MenuItem color="bg-[#008cc7]" title="MANTENIMIENTO EN GENERAL" navigateTo="#logo6">
      <Wrench class="text-white size-30 md:size-60" slot="icon" />
    </MenuItem>

    <MenuItem color="bg-black" title="MINERALES Y SUMINISTROS" navigateTo="#logo9">
      <Boxes class="text-white size-30 md:size-60" slot="icon" />
    </MenuItem>

    <MenuItem color="bg-[#008cc7]" title="SERVICIOS DE PISCINAS Y JACUZZIS" navigateTo="#logo10">
      <WavesLadder class="text-white size-30 md:size-60" slot="icon" />
    </MenuItem>
  </div>
  </div>
</div>
