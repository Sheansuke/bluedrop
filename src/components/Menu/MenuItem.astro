---
import { clsx } from "clsx";

interface Props {
  color: string;
  title: string;
  navigateTo: string
}

const { color,navigateTo, title = "No title" } = Astro.props;
---

<a href={navigateTo} class="flex flex-col items-center justify-end ">
  <div class="text-right w-44 mb-2 md:mb-4 md:w-auto">
    <h3 class="text-black  text-balance text-center md:text-4xl ">{title}</h3>
  </div>
  <div
    class={clsx(
      color,
      "rounded-2xl flex justify-center items-center size-30  md:size-120  p-2 md:p-8"
    )}
  >
    <slot name="icon" />
  </div>
</a>
