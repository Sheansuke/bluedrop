---
import { Image } from "astro:assets"

import osmosisIndustrial from "../../assets/v2/page-3-images/sin-fondo/page-3-sinfondo-image-1.png"
import osmosisDomestico from "../../assets/v2/page-3-images/sin-fondo/page-3-sinfondo-image-2.png"
import preTratamiento from "../../assets/v2/page-3-images/sin-fondo/page-3-sinfondo-image-3.png"

interface ProductItem {
  title: string
  subtitle: string
  description: string
  image: ImageMetadata
  alt: string
  width: number
  height: number
}

const products: ProductItem[] = [
  {
    title: "Ósmosis Inversa Doméstico",
    subtitle: "Purificación residencial",
    description: "Sistema compacto de ósmosis inversa de múltiples etapas con bomba, lámpara ultravioleta y grifo para agua pura en el hogar.",
    image: osmosisDomestico,
    alt: "Sistema de ósmosis inversa doméstico con filtros, bomba y grifo - BlueDrop SRL",
    width: 600,
    height: 800
  },
  {
    title: "Ósmosis Inversa Industrial",
    subtitle: "Alto rendimiento comercial",
    description: "Planta modular de ósmosis inversa montada en estructura de acero inoxidable, con membranas de alta presión y monitoreo de caudal.",
    image: osmosisIndustrial,
    alt: "Planta de ósmosis inversa industrial en acero inoxidable - BlueDrop SRL",
    width: 700,
    height: 800
  },
  {
    title: "Sistema pre-tratamiento",
    subtitle: "Protección y filtración primaria",
    description: "Tanques de fibra de vidrio con válvula de control automática y tanque de salmuera para retención de sedimentos y eliminación de dureza.",
    image: preTratamiento,
    alt: "Sistema de pre-tratamiento con tanque de fibra de vidrio y depósito de salmuera - BlueDrop SRL",
    width: 500,
    height: 800
  }
]
---

<section
  id="pagina3"
  class="w-full relative shadow-[0_20px_50px_rgba(0,140,199,0.2)] scroll-mt-20"
  aria-labelledby="instalacion-heading"
>
  <div class="bg-[#231f20] flex flex-col justify-center items-center px-6 py-10">
    <h2
      id="instalacion-heading"
      class="text-3xl md:text-5xl font-bold text-white text-center tracking-wider uppercase"
    >
      Instalación
    </h2>
    <p class="mt-3 max-w-3xl text-center text-base md:text-xl text-gray-200">
      Instalación profesional de sistemas de tratamiento de agua y piscinas para hogares, comercios e industrias en República Dominicana.
    </p>
  </div>

  <div class="container mx-auto px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 items-stretch">
      {products.map((product) => (
        <article class="bg-white rounded-2xl p-6 md:p-8 flex flex-col items-center justify-between border border-gray-100 shadow-md hover:shadow-xl transition-all duration-300">
          <header class="text-center w-full mb-6">
            <h3 class="text-xl md:text-2xl font-bold text-[rgb(11,65,88)] mb-2">
              {product.title}
            </h3>
            <span class="inline-block text-xs uppercase tracking-wider text-brand font-semibold px-3 py-1 bg-sky-50 rounded-full">
              {product.subtitle}
            </span>
          </header>

          <div class="w-full h-80 flex items-center justify-center p-4 my-2">
            <Image
              src={product.image}
              alt={product.alt}
              width={product.width}
              height={product.height}
              class="max-h-full max-w-full w-auto h-auto object-contain transition-transform duration-300 hover:scale-105"
              loading="lazy"
            />
          </div>

          <p class="text-sm md:text-base text-gray-600 text-center mt-6">
            {product.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
